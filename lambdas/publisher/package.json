  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-sns": "^3.915.0",
    "@types/node": "^22.10.2",
    "aws-sdk": "^2.1692.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "esbuild": "^0.24.2",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2"
  }
}
