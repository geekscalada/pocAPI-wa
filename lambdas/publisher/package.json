{
  "name": "publisher-lambda",
  "version": "1.0.0",
  "description": "Publisher Lambda Function",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build-esbuild": "esbuild src/index.ts --bundle --minify --sourcemap --platform=node --target=node20 --format=esm --outfile=dist/index.mjs --log-level=warning --define:Reflect.decorate=true",
    "build": "tsc && mkdir -p dist && cp package.json ./dist/ && npm install --prefix ./dist"
  },
